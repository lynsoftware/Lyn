<?xml version="1.0" encoding="utf-8" ?>

<!-- Lyst tema — hvite flater og mørkere gull (kontrast mot lys bakgrunn).
     Samme token-nøkler som DarkGoldTheme. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    x:Class="Calorie.Resources.Themes.LightGoldTheme">

    <!-- Flater -->
    <Color x:Key="Background">#F5F5F3</Color>
    <Color x:Key="Surface">#FFFFFF</Color>

    <!-- Identitet — mørkere gull enn i mørkt tema, for lesbarhet på lyst -->
    <Color x:Key="Primary">#C9A50E</Color>
    <Color x:Key="OnPrimary">#1F1F1F</Color>

    <!-- Tekst -->
    <Color x:Key="TextPrimary">#1A1A1A</Color>
    <Color x:Key="TextSecondary">#5A5A5A</Color>
    <Color x:Key="TextMuted">#767676</Color>

    <!-- Detaljer -->
    <Color x:Key="Separator">#E3E3E0</Color>
    <Color x:Key="NavInactive">#9A9A96</Color>

    <!-- Status -->
    <Color x:Key="OverLimit">#C93A24</Color>
    <Color x:Key="Success">#1E8E3E</Color>
    <Color x:Key="OnSuccess">#FFFFFF</Color>

    <!-- Kos-andelen i dagsbaren: innenfor og over grensen -->
    <Color x:Key="Treat">#8E44AD</Color>
    <Color x:Key="TreatOver">#C2185B</Color>
</ResourceDictionary>
