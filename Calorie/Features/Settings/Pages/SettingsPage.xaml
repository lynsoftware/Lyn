<?xml version="1.0" encoding="utf-8"?>

<!-- Innstillinger: mål, tema og språk. Tema- og språkbytte gjenskaper
     AppShell slik at alle farger/strenger tegnes på nytt. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:resources="clr-namespace:Calorie.Core.Resources.Strings;assembly=Calorie.Core"
             xmlns:vm="clr-namespace:Calorie.Core.Features.Settings.ViewModels;assembly=Calorie.Core"
             xmlns:common="clr-namespace:Calorie.Common.Components"
             x:Class="Calorie.Features.Settings.Pages.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             BackgroundColor="{DynamicResource Background}">
    <Grid RowDefinitions="Auto,*">

        <!-- Header -->
        <common:PageHeader Grid.Row="0"
                           Title="{x:Static resources:AppResources.Settings}"
                           ShowLogo="True"
                           ShowCloseButton="True"
                           CloseCommand="{Binding CloseCommand}"/>

        <!-- Innhold -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,16" Spacing="12">

                <!-- Mål -->
                <Label Text="{x:Static resources:AppResources.GoalsTitle}"
                       FontSize="15" FontAttributes="Bold"
                       TextColor="{DynamicResource TextPrimary}"/>
                <Button Text="{x:Static resources:AppResources.DailyGoalLabel}"
                        Command="{Binding OpenGoalsCommand}"
                        FontSize="15"
                        TextColor="{DynamicResource TextPrimary}"
                        BackgroundColor="{DynamicResource Surface}"
                        CornerRadius="12"
                        HeightRequest="52"
                        HorizontalOptions="Fill"/>

                <!-- Tema -->
                <Label Text="{x:Static resources:AppResources.Theme}"
                       FontSize="15" FontAttributes="Bold"
                       TextColor="{DynamicResource TextPrimary}"
                       Margin="0,10,0,0"/>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button Text="{x:Static resources:AppResources.Light}"
                            Command="{Binding SelectLightThemeCommand}"
                            FontSize="14"
                            CornerRadius="12"
                            HeightRequest="46"
                            BackgroundColor="{DynamicResource Surface}"
                            TextColor="{DynamicResource TextSecondary}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button"
                                         Binding="{Binding IsLightTheme}"
                                         Value="True">
                                <Setter Property="BackgroundColor" Value="{DynamicResource Primary}"/>
                                <Setter Property="TextColor" Value="{DynamicResource OnPrimary}"/>
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Grid.Column="1"
                            Text="{x:Static resources:AppResources.Dark}"
                            Command="{Binding SelectDarkThemeCommand}"
                            FontSize="14"
                            CornerRadius="12"
                            HeightRequest="46"
                            BackgroundColor="{DynamicResource Surface}"
                            TextColor="{DynamicResource TextSecondary}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button"
                                         Binding="{Binding IsDarkTheme}"
                                         Value="True">
                                <Setter Property="BackgroundColor" Value="{DynamicResource Primary}"/>
                                <Setter Property="TextColor" Value="{DynamicResource OnPrimary}"/>
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </Grid>

                <!-- Språk -->
                <Label Text="{x:Static resources:AppResources.Language}"
                       FontSize="15" FontAttributes="Bold"
                       TextColor="{DynamicResource TextPrimary}"
                       Margin="0,10,0,0"/>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button Text="Norsk"
                            Command="{Binding SelectNorwegianCommand}"
                            FontSize="14"
                            CornerRadius="12"
                            HeightRequest="46"
                            BackgroundColor="{DynamicResource Surface}"
                            TextColor="{DynamicResource TextSecondary}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button"
                                         Binding="{Binding IsNorwegian}"
                                         Value="True">
                                <Setter Property="BackgroundColor" Value="{DynamicResource Primary}"/>
                                <Setter Property="TextColor" Value="{DynamicResource OnPrimary}"/>
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Grid.Column="1"
                            Text="English"
                            Command="{Binding SelectEnglishCommand}"
                            FontSize="14"
                            CornerRadius="12"
                            HeightRequest="46"
                            BackgroundColor="{DynamicResource Surface}"
                            TextColor="{DynamicResource TextSecondary}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button"
                                         Binding="{Binding IsEnglish}"
                                         Value="True">
                                <Setter Property="BackgroundColor" Value="{DynamicResource Primary}"/>
                                <Setter Property="TextColor" Value="{DynamicResource OnPrimary}"/>
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </Grid>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
