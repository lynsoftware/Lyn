<?xml version="1.0" encoding="utf-8" ?>

<!-- Biblioteket (Måltider-fanen i navbaren): brukerens måltider og
     ingredienser, med søk og opprett/rediger. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:Calorie.Core.Resources.Strings;assembly=Calorie.Core"
             xmlns:library="clr-namespace:Calorie.Core.Features.Library;assembly=Calorie.Core"
             xmlns:vm="clr-namespace:Calorie.Core.Features.Library.ViewModels;assembly=Calorie.Core"
             xmlns:common="clr-namespace:Calorie.Common.Components"
             xmlns:navbar="clr-namespace:Calorie.Features.Navbar.Components"
             x:Class="Calorie.Features.Library.Pages.LibraryPage"
             x:DataType="vm:LibraryPageViewModel"
             BackgroundColor="{DynamicResource Background}">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

        <!-- Header -->
        <common:PageHeader Grid.Row="0"
                           Title="{x:Static strings:AppResources.LibraryTitle}"
                           ShowLogo="True"/>

        <!-- Faner + ny-knapp -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*,Auto" Padding="18,10,14,2" ColumnSpacing="18">
            <Button Text="{x:Static strings:AppResources.TabMeals}"
                    Command="{Binding SelectTabCommand}"
                    CommandParameter="{x:Static vm:LibraryItemKind.Meal}"
                    TextColor="{DynamicResource TextMuted}"
                    FontSize="15"
                    FontAttributes="Bold"
                    BackgroundColor="Transparent"
                    Padding="0">
                <Button.Triggers>
                    <DataTrigger TargetType="Button"
                                 Binding="{Binding IsMealsTabActive}"
                                 Value="True">
                        <Setter Property="TextColor" Value="{DynamicResource Primary}"/>
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Grid.Column="1"
                    Text="{x:Static strings:AppResources.TabIngredients}"
                    Command="{Binding SelectTabCommand}"
                    CommandParameter="{x:Static vm:LibraryItemKind.Ingredient}"
                    TextColor="{DynamicResource TextMuted}"
                    FontSize="15"
                    FontAttributes="Bold"
                    BackgroundColor="Transparent"
                    Padding="0">
                <Button.Triggers>
                    <DataTrigger TargetType="Button"
                                 Binding="{Binding IsIngredientsTabActive}"
                                 Value="True">
                        <Setter Property="TextColor" Value="{DynamicResource Primary}"/>
                    </DataTrigger>
                </Button.Triggers>
            </Button>

            <Button Grid.Column="3"
                    Text="{Binding NewItemButtonText}"
                    Command="{Binding NewItemCommand}"
                    FontSize="13"
                    FontAttributes="Bold"
                    TextColor="{DynamicResource OnPrimary}"
                    BackgroundColor="{DynamicResource Primary}"
                    CornerRadius="14"
                    Padding="14,6"/>
        </Grid>

        <!-- Søk -->
        <Border Grid.Row="2"
                BackgroundColor="{DynamicResource Surface}"
                StrokeThickness="0"
                Margin="14,8,14,0"
                Padding="12,0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>
            <Entry Placeholder="{x:Static strings:AppResources.SearchPlaceholder}"
                   Text="{Binding SearchText}"
                   BackgroundColor="Transparent"
                   TextColor="{DynamicResource TextPrimary}"
                   PlaceholderColor="{DynamicResource TextMuted}"/>
        </Border>

        <!-- Listen -->
        <CollectionView Grid.Row="3"
                        Margin="14,6"
                        ItemsSource="{Binding FilteredItems}"
                        SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                        SelectionMode="Single">
            <!-- Tomtilstand: tomt bibliotek eller søk uten treff — samme
                 melding + opprett-hint som logge-søket -->
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="4,24" Spacing="4">
                    <Label Text="{x:Static strings:AppResources.NoLibraryMatches}"
                           FontSize="14"
                           TextColor="{DynamicResource TextMuted}"
                           HorizontalOptions="Center"/>
                    <Label Text="{Binding EmptyHint}"
                           FontSize="13"
                           TextColor="{DynamicResource TextSecondary}"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:LibraryItem">
                    <Grid Padding="4,10" ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="1">
                            <Label Text="{Binding Name}"
                                   FontSize="15"
                                   TextColor="{DynamicResource TextPrimary}"/>
                            <Label Text="{Binding Details}"
                                   FontSize="12"
                                   TextColor="{DynamicResource TextMuted}"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="1"
                               Text="{Binding Brand}"
                               FontSize="12"
                               TextColor="{DynamicResource TextMuted}"
                               VerticalOptions="Center"/>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Bunn-navigasjon -->
        <navbar:BottomNavBar
            Grid.Row="4"
            ActiveTab="Meals"
            HomeCommand="{Binding GoHomeCommand}"
            AddCommand="{Binding OpenLogCommand}"
            StatsCommand="{Binding OpenStatsCommand}"
            SettingsCommand="{Binding OpenSettingsCommand}"/>
    </Grid>
</ContentPage>
