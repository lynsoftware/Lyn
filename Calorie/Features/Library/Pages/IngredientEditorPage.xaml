<?xml version="1.0" encoding="utf-8" ?>

<!-- Ingrediens-editor: navn, merke, næringsverdier per 100 g og valgfri
     stykk-støtte. Brukes for både ny og eksisterende ingrediens, og
     gjenbrukes senere av EAN-flyten (bom i katalogen = fyll inn selv). -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:Calorie.Core.Resources.Strings;assembly=Calorie.Core"
             xmlns:vm="clr-namespace:Calorie.Core.Features.Library.ViewModels;assembly=Calorie.Core"
             xmlns:common="clr-namespace:Calorie.Common.Components"
             x:Class="Calorie.Features.Library.Pages.IngredientEditorPage"
             x:DataType="vm:IngredientEditorViewModel"
             BackgroundColor="{DynamicResource Background}">

    <Grid RowDefinitions="Auto,*">

        <!-- Header -->
        <common:PageHeader Grid.Row="0"
                           Title="{Binding Title}"
                           ShowCloseButton="True"
                           CloseCommand="{Binding CloseCommand}"/>

        <!-- Skjema -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,14" Spacing="10">

                <Label Text="{x:Static strings:AppResources.NameLabel}"
                       FontSize="12" TextColor="{DynamicResource TextMuted}"/>
                <Border BackgroundColor="{DynamicResource Surface}" StrokeThickness="0" Padding="12,0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                    <Entry Text="{Binding Name}"
                           TextColor="{DynamicResource TextPrimary}"
                           BackgroundColor="Transparent"/>
                </Border>

                <Label Text="{x:Static strings:AppResources.BrandLabel}"
                       FontSize="12" TextColor="{DynamicResource TextMuted}"/>
                <Border BackgroundColor="{DynamicResource Surface}" StrokeThickness="0" Padding="12,0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                    <Entry Text="{Binding Brand}"
                           TextColor="{DynamicResource TextPrimary}"
                           BackgroundColor="Transparent"/>
                </Border>

                <!-- Næringsverdier per 100 g -->
                <Label Text="{x:Static strings:AppResources.NutritionPer100gHeader}"
                       FontSize="15" FontAttributes="Bold"
                       TextColor="{DynamicResource TextPrimary}"
                       Margin="0,10,0,0"/>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4">
                    <Label Grid.Row="0" Grid.Column="0"
                           Text="{x:Static strings:AppResources.CaloriesLabel}"
                           FontSize="12" TextColor="{DynamicResource TextMuted}"/>
                    <Label Grid.Row="0" Grid.Column="1"
                           Text="{x:Static strings:AppResources.ProteinLabel}"
                           FontSize="12" TextColor="{DynamicResource TextMuted}"/>

                    <Border Grid.Row="1" Grid.Column="0" BackgroundColor="{DynamicResource Surface}" StrokeThickness="0" Padding="12,0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                        <Entry Text="{Binding CaloriesText}" Keyboard="Numeric"
                               TextColor="{DynamicResource TextPrimary}" BackgroundColor="Transparent"/>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" BackgroundColor="{DynamicResource Surface}" StrokeThickness="0" Padding="12,0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                        <Entry Text="{Binding ProteinText}" Keyboard="Numeric"
                               TextColor="{DynamicResource TextPrimary}" BackgroundColor="Transparent"/>
                    </Border>

                    <Label Grid.Row="2" Grid.Column="0"
                           Text="{x:Static strings:AppResources.CarbsLabel}"
                           FontSize="12" TextColor="{DynamicResource TextMuted}" Margin="0,6,0,0"/>
                    <Label Grid.Row="2" Grid.Column="1"
                           Text="{x:Static strings:AppResources.FatLabel}"
                           FontSize="12" TextColor="{DynamicResource TextMuted}" Margin="0,6,0,0"/>

                    <Border Grid.Row="3" Grid.Column="0" BackgroundColor="{DynamicResource Surface}" StrokeThickness="0" Padding="12,0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                        <Entry Text="{Binding CarbsText}" Keyboard="Numeric"
                               TextColor="{DynamicResource TextPrimary}" BackgroundColor="Transparent"/>
                    </Border>
                    <Border Grid.Row="3" Grid.Column="1" BackgroundColor="{DynamicResource Surface}" StrokeThickness="0" Padding="12,0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                        <Entry Text="{Binding FatText}" Keyboard="Numeric"
                               TextColor="{DynamicResource TextPrimary}" BackgroundColor="Transparent"/>
                    </Border>
                </Grid>

                <!-- Stykk-støtte -->
                <Label Text="{x:Static strings:AppResources.UnitSectionHeader}"
                       FontSize="15" FontAttributes="Bold"
                       TextColor="{DynamicResource TextPrimary}"
                       Margin="0,10,0,0"/>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" RowDefinitions="Auto,Auto" RowSpacing="4">
                    <Label Grid.Row="0" Grid.Column="0"
                           Text="{x:Static strings:AppResources.UnitNameLabel}"
                           FontSize="12" TextColor="{DynamicResource TextMuted}"/>
                    <Label Grid.Row="0" Grid.Column="1"
                           Text="{x:Static strings:AppResources.UnitWeightLabel}"
                           FontSize="12" TextColor="{DynamicResource TextMuted}"/>

                    <Border Grid.Row="1" Grid.Column="0" BackgroundColor="{DynamicResource Surface}" StrokeThickness="0" Padding="12,0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                        <Entry Text="{Binding UnitNameText}"
                               TextColor="{DynamicResource TextPrimary}" BackgroundColor="Transparent"/>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" BackgroundColor="{DynamicResource Surface}" StrokeThickness="0" Padding="12,0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                        <Entry Text="{Binding UnitWeightText}" Keyboard="Numeric"
                               TextColor="{DynamicResource TextPrimary}" BackgroundColor="Transparent"/>
                    </Border>
                </Grid>

                <!-- Slett (kun eksisterende, blokkeres ved bruk i måltid) + Lagre -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,14,0,20">
                    <Button Text="{x:Static strings:AppResources.Delete}"
                            IsVisible="{Binding IsDeleteVisible}"
                            Command="{Binding DeleteCommand}"
                            FontSize="16"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource OverLimit}"
                            BackgroundColor="Transparent"
                            BorderColor="{DynamicResource OverLimit}"
                            BorderWidth="1"
                            CornerRadius="14"
                            Padding="24,0"
                            HeightRequest="52"/>
                    <Button Grid.Column="1"
                            Text="{x:Static strings:AppResources.Save}"
                            Command="{Binding SaveCommand}"
                            FontSize="16"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource OnPrimary}"
                            BackgroundColor="{DynamicResource Primary}"
                            CornerRadius="14"
                            HeightRequest="52"/>
                </Grid>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
