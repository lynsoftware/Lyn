<?xml version="1.0" encoding="utf-8" ?>

<!-- Måltidsbygger: navn + ingredienser med gram, live kcal-total.
     Brukes for både nytt og eksisterende måltid. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:Calorie.Core.Resources.Strings;assembly=Calorie.Core"
             xmlns:library="clr-namespace:Calorie.Core.Features.Library;assembly=Calorie.Core"
             x:Class="Calorie.Features.Library.Pages.MealBuilderPage"
             BackgroundColor="{DynamicResource Background}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <Border Grid.Row="0"
                BackgroundColor="{DynamicResource Surface}"
                Padding="10,10"
                StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0" />
            </Border.StrokeShape>

            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="60" />
                </Grid.ColumnDefinitions>

                <Label x:Name="TitleLabel"
                       Grid.Column="1"
                       FontSize="24"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       TextColor="{DynamicResource Primary}"/>

                <Button Grid.Column="2"
                        Text="&#xf00d;"
                        FontFamily="FontAwesome"
                        FontSize="24"
                        TextColor="{DynamicResource Primary}"
                        BackgroundColor="Transparent"
                        WidthRequest="50"
                        HeightRequest="50"
                        VerticalOptions="Center"
                        HorizontalOptions="Center"
                        Clicked="OnCloseClicked"/>
            </Grid>
        </Border>

        <!-- Innhold -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,14" Spacing="10">

                <Label Text="{x:Static strings:AppResources.NameLabel}"
                       FontSize="12" TextColor="{DynamicResource TextMuted}"/>
                <Border BackgroundColor="{DynamicResource Surface}" StrokeThickness="0" Padding="12,0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                    <Entry x:Name="NameEntry"
                           TextColor="{DynamicResource TextPrimary}"
                           BackgroundColor="Transparent"/>
                </Border>

                <!-- Ingrediensene i måltidet -->
                <Border BackgroundColor="{DynamicResource Surface}" StrokeThickness="0" Padding="16,12" Margin="0,6,0,0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape>
                    <VerticalStackLayout Spacing="8">

                        <VerticalStackLayout x:Name="ComponentsContainer" Spacing="8"/>

                        <BoxView HeightRequest="1" Color="{DynamicResource Separator}"/>

                        <!-- Legg til ingrediens: velger + gram -->
                        <Label Text="{x:Static strings:AppResources.AddIngredientToMeal}"
                               FontSize="12" TextColor="{DynamicResource TextMuted}"/>
                        <Grid ColumnDefinitions="*,70,Auto,Auto" ColumnSpacing="8">
                            <Picker x:Name="IngredientPicker"
                                    ItemDisplayBinding="{Binding Name, x:DataType=library:LibraryIngredient}"
                                    TextColor="{DynamicResource TextPrimary}"
                                    BackgroundColor="Transparent"
                                    VerticalOptions="Center"
                                    SelectedIndexChanged="OnIngredientPicked"/>
                            <Entry x:Name="AmountEntry"
                                   Grid.Column="1"
                                   Keyboard="Numeric"
                                   Placeholder="100"
                                   TextColor="{DynamicResource TextPrimary}"
                                   PlaceholderColor="{DynamicResource TextMuted}"
                                   BackgroundColor="Transparent"
                                   VerticalOptions="Center"/>

                            <!-- Enhets-toggle: bytter mellom gram og stykk når ingrediensen
                                 har stykkvekt ("1 stk = 60 g"). Lagres alltid i gram. -->
                            <Button x:Name="UnitToggleButton"
                                    Grid.Column="2"
                                    Text="g"
                                    FontSize="13"
                                    FontAttributes="Bold"
                                    Padding="10,0"
                                    TextColor="{DynamicResource TextSecondary}"
                                    BackgroundColor="{DynamicResource Background}"
                                    CornerRadius="8"
                                    HeightRequest="30"
                                    MinimumHeightRequest="30"
                                    MinimumWidthRequest="44"
                                    VerticalOptions="Center"
                                    Clicked="OnUnitToggleClicked"/>

                            <!-- Pluss = opprett ny ingrediens; hake = legg valgt ingrediens i måltidet.
                                 Padding 0 — Buttons standard-padding klemmer glyfen i små knapper. -->
                            <VerticalStackLayout Grid.Column="3" Spacing="8">
                                <Button Text="&#xf067;"
                                        FontFamily="FontAwesome"
                                        FontSize="18"
                                        Padding="0"
                                        TextColor="{DynamicResource OnPrimary}"
                                        BackgroundColor="{DynamicResource Primary}"
                                        WidthRequest="38"
                                        HeightRequest="38"
                                        MinimumHeightRequest="38"
                                        MinimumWidthRequest="38"
                                        CornerRadius="8"
                                        Clicked="OnNewIngredientClicked"/>
                                <Button Text="&#xf00c;"
                                        FontFamily="FontAwesome"
                                        FontSize="18"
                                        Padding="0"
                                        TextColor="{DynamicResource OnSuccess}"
                                        BackgroundColor="{DynamicResource Success}"
                                        WidthRequest="38"
                                        HeightRequest="38"
                                        MinimumHeightRequest="38"
                                        MinimumWidthRequest="38"
                                        CornerRadius="8"
                                        Clicked="OnAddComponentClicked"/>
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Total -->
                <Label x:Name="TotalLabel"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource Primary}"
                       HorizontalOptions="Center"
                       Margin="0,6,0,0"/>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Lagre. I Tilpass-modus: primær = bruk engangs-kopien i loggen (malen
             røres ikke), sekundær = skriv endringene tilbake til malen også. -->
        <VerticalStackLayout Grid.Row="2" Spacing="8" Margin="16,8,16,16">
            <Button x:Name="UpdateTemplateButton"
                    IsVisible="False"
                    FontSize="14"
                    FontAttributes="Bold"
                    TextColor="{DynamicResource Primary}"
                    BackgroundColor="Transparent"
                    BorderColor="{DynamicResource Primary}"
                    BorderWidth="1"
                    CornerRadius="14"
                    HeightRequest="46"
                    Clicked="OnUpdateTemplateClicked"/>
            <Button x:Name="SaveButton"
                    Text="{x:Static strings:AppResources.Save}"
                    FontSize="16"
                    FontAttributes="Bold"
                    TextColor="{DynamicResource OnPrimary}"
                    BackgroundColor="{DynamicResource Primary}"
                    CornerRadius="14"
                    HeightRequest="52"
                    Clicked="OnSaveClicked"/>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
