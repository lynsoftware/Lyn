<?xml version="1.0" encoding="utf-8" ?>

<!-- Mål-oppsett: dagsmål, Limit/Target-modus, valgfrie makromål og
     valgfrie kaloribudsjetter per måltidstype. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:Calorie.Core.Resources.Strings;assembly=Calorie.Core"
             x:Class="Calorie.Features.Goals.Pages.GoalSettingsPage"
             BackgroundColor="{DynamicResource Background}">

    <Grid RowDefinitions="Auto,*">

        <!-- Header -->
        <Border Grid.Row="0"
                BackgroundColor="{DynamicResource Surface}"
                Padding="10,10"
                StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0" />
            </Border.StrokeShape>

            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="60" />
                </Grid.ColumnDefinitions>

                <Label Grid.Column="1"
                       Text="{x:Static strings:AppResources.GoalsTitle}"
                       FontSize="24"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       TextColor="{DynamicResource Primary}"/>

                <Button Grid.Column="2"
                        Text="&#xf00d;"
                        FontFamily="FontAwesome"
                        FontSize="24"
                        TextColor="{DynamicResource Primary}"
                        BackgroundColor="Transparent"
                        WidthRequest="50"
                        HeightRequest="50"
                        VerticalOptions="Center"
                        HorizontalOptions="Center"
                        Clicked="OnCloseClicked"/>
            </Grid>
        </Border>

        <!-- Skjema -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,14" Spacing="10">

                <!-- Dagsmål -->
                <Label Text="{x:Static strings:AppResources.DailyGoalLabel}"
                       FontSize="12" TextColor="{DynamicResource TextMuted}"/>
                <Border BackgroundColor="{DynamicResource Surface}" StrokeThickness="0" Padding="12,0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                    <Entry x:Name="DailyCaloriesEntry" Keyboard="Numeric"
                           TextColor="{DynamicResource TextPrimary}" BackgroundColor="Transparent"/>
                </Border>

                <!-- Modus: maksgrense eller mål å nå -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,4,0,0">
                    <Button x:Name="LimitModeButton"
                            Text="{x:Static strings:AppResources.ModeLimit}"
                            FontSize="14"
                            CornerRadius="12"
                            HeightRequest="44"
                            Clicked="OnLimitModeClicked"/>
                    <Button x:Name="TargetModeButton"
                            Grid.Column="1"
                            Text="{x:Static strings:AppResources.ModeTarget}"
                            FontSize="14"
                            CornerRadius="12"
                            HeightRequest="44"
                            Clicked="OnTargetModeClicked"/>
                </Grid>

                <!-- Makromål -->
                <Label Text="{x:Static strings:AppResources.MacroGoalsHeader}"
                       FontSize="15" FontAttributes="Bold"
                       TextColor="{DynamicResource TextPrimary}"
                       Margin="0,10,0,0"/>

                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10" RowDefinitions="Auto,Auto" RowSpacing="4">
                    <Label Grid.Column="0" Text="{x:Static strings:AppResources.ProteinLabel}"
                           FontSize="12" TextColor="{DynamicResource TextMuted}"/>
                    <Label Grid.Column="1" Text="{x:Static strings:AppResources.CarbsLabel}"
                           FontSize="12" TextColor="{DynamicResource TextMuted}"/>
                    <Label Grid.Column="2" Text="{x:Static strings:AppResources.FatLabel}"
                           FontSize="12" TextColor="{DynamicResource TextMuted}"/>

                    <Border Grid.Row="1" Grid.Column="0" BackgroundColor="{DynamicResource Surface}" StrokeThickness="0" Padding="12,0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                        <Entry x:Name="ProteinGoalEntry" Keyboard="Numeric"
                               TextColor="{DynamicResource TextPrimary}" BackgroundColor="Transparent"/>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" BackgroundColor="{DynamicResource Surface}" StrokeThickness="0" Padding="12,0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                        <Entry x:Name="CarbsGoalEntry" Keyboard="Numeric"
                               TextColor="{DynamicResource TextPrimary}" BackgroundColor="Transparent"/>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="2" BackgroundColor="{DynamicResource Surface}" StrokeThickness="0" Padding="12,0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                        <Entry x:Name="FatGoalEntry" Keyboard="Numeric"
                               TextColor="{DynamicResource TextPrimary}" BackgroundColor="Transparent"/>
                    </Border>
                </Grid>

                <!-- Budsjett per måltid -->
                <Label Text="{x:Static strings:AppResources.MealBudgetsHeader}"
                       FontSize="15" FontAttributes="Bold"
                       TextColor="{DynamicResource TextPrimary}"
                       Margin="0,10,0,0"/>

                <!-- Én rad per måltidstype — bygges i code-behind -->
                <VerticalStackLayout x:Name="BudgetsContainer" Spacing="6"/>

                <!-- Lagre -->
                <Button Text="{x:Static strings:AppResources.Save}"
                        FontSize="16"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource OnPrimary}"
                        BackgroundColor="{DynamicResource Primary}"
                        CornerRadius="14"
                        Margin="0,14,0,20"
                        HeightRequest="52"
                        Clicked="OnSaveClicked"/>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
