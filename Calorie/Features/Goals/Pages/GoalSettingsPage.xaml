<?xml version="1.0" encoding="utf-8" ?>

<!-- Mål-oppsett: dagsmål, Limit/Target-modus, valgfrie makromål og
     valgfrie kaloribudsjetter per måltidstype. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:Calorie.Core.Resources.Strings;assembly=Calorie.Core"
             xmlns:vm="clr-namespace:Calorie.Core.Features.Goals.ViewModels;assembly=Calorie.Core"
             xmlns:common="clr-namespace:Calorie.Common.Components"
             x:Class="Calorie.Features.Goals.Pages.GoalSettingsPage"
             x:DataType="vm:GoalSettingsViewModel"
             BackgroundColor="{DynamicResource Background}">

    <Grid RowDefinitions="Auto,*">

        <!-- Header -->
        <common:PageHeader Grid.Row="0"
                           Title="{x:Static strings:AppResources.GoalsTitle}"
                           ShowCloseButton="True"
                           CloseCommand="{Binding CloseCommand}"/>

        <!-- Skjema -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,14" Spacing="10">

                <!-- Dagsmål -->
                <Label Text="{x:Static strings:AppResources.DailyGoalLabel}"
                       FontSize="12" TextColor="{DynamicResource TextMuted}"/>
                <Border BackgroundColor="{DynamicResource Surface}" StrokeThickness="0" Padding="12,0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                    <Entry Text="{Binding DailyCaloriesText}" Keyboard="Numeric"
                           TextColor="{DynamicResource TextPrimary}" BackgroundColor="Transparent"/>
                </Border>

                <!-- Modus: maksgrense eller mål å nå -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,4,0,0">
                    <Button Text="{x:Static strings:AppResources.ModeLimit}"
                            Command="{Binding SelectLimitModeCommand}"
                            FontSize="14"
                            CornerRadius="12"
                            HeightRequest="44"
                            BackgroundColor="{DynamicResource Surface}"
                            TextColor="{DynamicResource TextSecondary}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button"
                                         Binding="{Binding IsLimitMode}"
                                         Value="True">
                                <Setter Property="BackgroundColor" Value="{DynamicResource Primary}"/>
                                <Setter Property="TextColor" Value="{DynamicResource OnPrimary}"/>
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Grid.Column="1"
                            Text="{x:Static strings:AppResources.ModeTarget}"
                            Command="{Binding SelectTargetModeCommand}"
                            FontSize="14"
                            CornerRadius="12"
                            HeightRequest="44"
                            BackgroundColor="{DynamicResource Surface}"
                            TextColor="{DynamicResource TextSecondary}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button"
                                         Binding="{Binding IsTargetMode}"
                                         Value="True">
                                <Setter Property="BackgroundColor" Value="{DynamicResource Primary}"/>
                                <Setter Property="TextColor" Value="{DynamicResource OnPrimary}"/>
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </Grid>

                <!-- Kos-andel: valgfri prosent av dagsmålet som kan være kos -->
                <Label Text="{x:Static strings:AppResources.TreatShareLabel}"
                       FontSize="12" TextColor="{DynamicResource TextMuted}"
                       Margin="0,10,0,0"/>
                <Grid ColumnDefinitions="120,*" ColumnSpacing="10">
                    <Border BackgroundColor="{DynamicResource Surface}" StrokeThickness="0" Padding="12,0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                        <Entry Text="{Binding TreatPercentText}" Keyboard="Numeric"
                               TextColor="{DynamicResource TextPrimary}" BackgroundColor="Transparent"/>
                    </Border>
                    <Label Grid.Column="1"
                           Text="{Binding TreatKcalPreview}"
                           FontSize="14"
                           TextColor="{DynamicResource TextSecondary}"
                           VerticalOptions="Center"/>
                </Grid>

                <!-- Makromål -->
                <Label Text="{x:Static strings:AppResources.MacroGoalsHeader}"
                       FontSize="15" FontAttributes="Bold"
                       TextColor="{DynamicResource TextPrimary}"
                       Margin="0,10,0,0"/>

                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10" RowDefinitions="Auto,Auto" RowSpacing="4">
                    <Label Grid.Column="0" Text="{x:Static strings:AppResources.ProteinLabel}"
                           FontSize="12" TextColor="{DynamicResource TextMuted}"/>
                    <Label Grid.Column="1" Text="{x:Static strings:AppResources.CarbsLabel}"
                           FontSize="12" TextColor="{DynamicResource TextMuted}"/>
                    <Label Grid.Column="2" Text="{x:Static strings:AppResources.FatLabel}"
                           FontSize="12" TextColor="{DynamicResource TextMuted}"/>

                    <Border Grid.Row="1" Grid.Column="0" BackgroundColor="{DynamicResource Surface}" StrokeThickness="0" Padding="12,0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                        <Entry Text="{Binding ProteinText}" Keyboard="Numeric"
                               TextColor="{DynamicResource TextPrimary}" BackgroundColor="Transparent"/>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" BackgroundColor="{DynamicResource Surface}" StrokeThickness="0" Padding="12,0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                        <Entry Text="{Binding CarbsText}" Keyboard="Numeric"
                               TextColor="{DynamicResource TextPrimary}" BackgroundColor="Transparent"/>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="2" BackgroundColor="{DynamicResource Surface}" StrokeThickness="0" Padding="12,0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                        <Entry Text="{Binding FatText}" Keyboard="Numeric"
                               TextColor="{DynamicResource TextPrimary}" BackgroundColor="Transparent"/>
                    </Border>
                </Grid>

                <!-- Budsjett per måltid -->
                <Label Text="{x:Static strings:AppResources.MealBudgetsHeader}"
                       FontSize="15" FontAttributes="Bold"
                       TextColor="{DynamicResource TextPrimary}"
                       Margin="0,10,0,0"/>

                <!-- Én rad per måltidstype — fra BudgetOptions i VM-en -->
                <VerticalStackLayout Spacing="6"
                                     BindableLayout.ItemsSource="{Binding BudgetOptions}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:BudgetOption">
                            <Grid ColumnSpacing="10" ColumnDefinitions="*,110">
                                <Label Text="{Binding Label}"
                                       FontSize="15"
                                       TextColor="{DynamicResource TextPrimary}"
                                       VerticalOptions="Center"/>
                                <Border Grid.Column="1"
                                        BackgroundColor="{DynamicResource Surface}"
                                        StrokeThickness="0"
                                        Padding="12,0">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                                    <Entry Text="{Binding AmountText}"
                                           Keyboard="Numeric"
                                           FontSize="15"
                                           HorizontalTextAlignment="End"
                                           TextColor="{DynamicResource TextPrimary}"
                                           BackgroundColor="Transparent"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- Lagre -->
                <Button Text="{x:Static strings:AppResources.Save}"
                        Command="{Binding SaveCommand}"
                        FontSize="16"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource OnPrimary}"
                        BackgroundColor="{DynamicResource Primary}"
                        CornerRadius="14"
                        Margin="0,14,0,20"
                        HeightRequest="52"/>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
