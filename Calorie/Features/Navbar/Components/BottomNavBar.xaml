<?xml version="1.0" encoding="utf-8" ?>

<!-- Felles bunn-navigasjon: fire faner + opphøyd pluss-knapp (ny loggføring)
     i midten. Siden som bruker den setter ActiveTab og abonnerer på
     *Clicked-eventene. Farger via tema-tokens. -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Calorie.Features.Navbar.Components.BottomNavBar">

    <Grid>

        <!-- Selve baren -->
        <Border BackgroundColor="{DynamicResource Surface}"
                Padding="0"
                StrokeThickness="0"
                HeightRequest="70"
                VerticalOptions="End"
                HorizontalOptions="FillAndExpand">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="Black"
                        Opacity="0.25"
                        Radius="20"
                        Offset="0,-5" />
            </Border.Shadow>

            <!-- Midtkolonnen er reservert til pluss-knappen som flyter over baren -->
            <Grid ColumnDefinitions="*,*,80,*,*">

                <!-- Hjem / dagslogg -->
                <Button x:Name="HomeButton"
                        Grid.Column="0"
                        Text="&#xf015;"
                        FontFamily="FontAwesome"
                        FontSize="24"
                        BackgroundColor="Transparent"
                        VerticalOptions="Center"
                        HorizontalOptions="Center"
                        Clicked="OnHomeClicked"/>

                <!-- Måltider / bibliotek -->
                <Button x:Name="MealsButton"
                        Grid.Column="1"
                        Text="&#xf2e7;"
                        FontFamily="FontAwesome"
                        FontSize="24"
                        BackgroundColor="Transparent"
                        VerticalOptions="Center"
                        HorizontalOptions="Center"
                        Clicked="OnMealsClicked"/>

                <!-- Statistikk / dashboard -->
                <Button x:Name="StatsButton"
                        Grid.Column="3"
                        Text="&#xf080;"
                        FontFamily="FontAwesome"
                        FontSize="24"
                        BackgroundColor="Transparent"
                        VerticalOptions="Center"
                        HorizontalOptions="Center"
                        Clicked="OnStatsClicked"/>

                <!-- Innstillinger -->
                <Button x:Name="SettingsButton"
                        Grid.Column="4"
                        Text="&#xf013;"
                        FontFamily="FontAwesome"
                        FontSize="24"
                        BackgroundColor="Transparent"
                        VerticalOptions="Center"
                        HorizontalOptions="Center"
                        Clicked="OnSettingsClicked"/>
            </Grid>
        </Border>

        <!-- Opphøyd pluss-knapp — ny loggføring -->
        <Button x:Name="AddButton"
                Text="&#xf067;"
                FontFamily="FontAwesome"
                FontSize="26"
                TextColor="{DynamicResource OnPrimary}"
                BackgroundColor="{DynamicResource Primary}"
                WidthRequest="64"
                HeightRequest="64"
                CornerRadius="32"
                HorizontalOptions="Center"
                VerticalOptions="End"
                Margin="0,0,0,32"
                Clicked="OnAddClicked">
            <Button.Shadow>
                <Shadow Brush="{DynamicResource Primary}"
                        Opacity="0.5"
                        Radius="15"
                        Offset="0,5" />
            </Button.Shadow>
        </Button>
    </Grid>
</ContentView>
