<?xml version="1.0" encoding="utf-8" ?>

<!-- Statistikk: ukessøyler (kcal per dag mot dagens gjeldende mål),
     nøkkeltall og fordeling per måltidstype. Beregnes lokalt fra SQLite. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:Calorie.Core.Resources.Strings;assembly=Calorie.Core"
             xmlns:components="clr-namespace:Calorie.Features.Navbar.Components"
             xmlns:navbar="clr-namespace:Calorie.Features.Navbar"
             xmlns:components1="clr-namespace:Calorie.Features.Navbar.Components"
             x:Class="Calorie.Features.Stats.Pages.StatsPage"
             BackgroundColor="{DynamicResource Background}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <Border Grid.Row="0"
                BackgroundColor="{DynamicResource Surface}"
                Padding="10,10"
                StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0" />
            </Border.StrokeShape>

            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="60" />
                </Grid.ColumnDefinitions>

                <Image Source="logo.png"
                       Grid.Column="0"
                       WidthRequest="70"
                       HeightRequest="70"
                       VerticalOptions="Center"
                       HorizontalOptions="Center"/>

                <Label Grid.Column="1"
                       Text="{x:Static strings:AppResources.StatsTitle}"
                       FontSize="28"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       TextColor="{DynamicResource Primary}"/>
            </Grid>
        </Border>

        <!-- Innhold -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="14,12" Spacing="12">

                <!-- Uke-navigasjon -->
                <Grid ColumnDefinitions="50,*,50">
                    <Button Grid.Column="0"
                            Text="&#xf053;"
                            FontFamily="FontAwesome"
                            FontSize="18"
                            TextColor="{DynamicResource NavInactive}"
                            BackgroundColor="Transparent"
                            HorizontalOptions="Center"
                            Clicked="OnPreviousWeekClicked"/>
                    <Label x:Name="WeekLabel"
                           Grid.Column="1"
                           FontSize="17"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource TextPrimary}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                    <Button x:Name="NextWeekButton"
                            Grid.Column="2"
                            Text="&#xf054;"
                            FontFamily="FontAwesome"
                            FontSize="18"
                            TextColor="{DynamicResource NavInactive}"
                            BackgroundColor="Transparent"
                            HorizontalOptions="Center"
                            Clicked="OnNextWeekClicked"/>
                </Grid>

                <!-- Ukessøyler -->
                <Border BackgroundColor="{DynamicResource Surface}"
                        StrokeThickness="0"
                        Padding="14,14,14,10">
                    <Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape>
                    <VerticalStackLayout Spacing="8">
                        <Label x:Name="GoalCaptionLabel"
                               FontSize="12"
                               TextColor="{DynamicResource TextMuted}"
                               HorizontalOptions="Center"/>
                        <Grid x:Name="BarsGrid" ColumnSpacing="8"/>
                        <Label x:Name="EmptyLabel"
                               Text="{x:Static strings:AppResources.NoDataThisWeek}"
                               FontSize="14"
                               TextColor="{DynamicResource TextMuted}"
                               HorizontalOptions="Center"
                               IsVisible="False"
                               Margin="0,8"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Nøkkeltall -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                    <Border BackgroundColor="{DynamicResource Surface}" StrokeThickness="0" Padding="10,12">
                        <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
                        <VerticalStackLayout Spacing="2">
                            <Label x:Name="AverageValueLabel" FontSize="20" FontAttributes="Bold"
                                   TextColor="{DynamicResource Primary}" HorizontalOptions="Center"/>
                            <Label Text="{x:Static strings:AppResources.WeekAverage}" FontSize="11"
                                   TextColor="{DynamicResource TextMuted}" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" BackgroundColor="{DynamicResource Surface}" StrokeThickness="0" Padding="10,12">
                        <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
                        <VerticalStackLayout Spacing="2">
                            <Label x:Name="OnTrackValueLabel" FontSize="20" FontAttributes="Bold"
                                   TextColor="{DynamicResource Primary}" HorizontalOptions="Center"/>
                            <Label Text="{x:Static strings:AppResources.DaysOnTrack}" FontSize="11"
                                   TextColor="{DynamicResource TextMuted}" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="2" BackgroundColor="{DynamicResource Surface}" StrokeThickness="0" Padding="10,12">
                        <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
                        <VerticalStackLayout Spacing="2">
                            <Label x:Name="LoggedDaysValueLabel" FontSize="20" FontAttributes="Bold"
                                   TextColor="{DynamicResource Primary}" HorizontalOptions="Center"/>
                            <Label Text="{x:Static strings:AppResources.LoggedDays}" FontSize="11"
                                   TextColor="{DynamicResource TextMuted}" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Fordeling per måltidstype -->
                <Border x:Name="DistributionCard"
                        BackgroundColor="{DynamicResource Surface}"
                        StrokeThickness="0"
                        Padding="16,12">
                    <Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{x:Static strings:AppResources.MealDistribution}"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource TextPrimary}"/>
                        <VerticalStackLayout x:Name="DistributionContainer" Spacing="8"/>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Bunn-navigasjon -->
        <components1:BottomNavBar
            Grid.Row="2"
            ActiveTab="Stats"
            HomeClicked="OnHomeClicked"
            MealsClicked="OnMealsClicked"
            AddClicked="OnLogClicked"
            SettingsClicked="OnSettingsClicked"/>
    </Grid>
</ContentPage>
