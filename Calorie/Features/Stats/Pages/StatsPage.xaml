<?xml version="1.0" encoding="utf-8" ?>

<!-- Statistikk: ukessøyler (kcal per dag mot dagens gjeldende mål),
     nøkkeltall og fordeling per måltidstype. Beregnes lokalt fra SQLite. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:Calorie.Core.Resources.Strings;assembly=Calorie.Core"
             xmlns:vm="clr-namespace:Calorie.Core.Features.Stats.ViewModels;assembly=Calorie.Core"
             xmlns:common="clr-namespace:Calorie.Common.Components"
             xmlns:navbar="clr-namespace:Calorie.Features.Navbar.Components"
             x:Class="Calorie.Features.Stats.Pages.StatsPage"
             x:DataType="vm:StatsViewModel"
             BackgroundColor="{DynamicResource Background}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <common:PageHeader Grid.Row="0"
                           Title="{x:Static strings:AppResources.StatsTitle}"
                           ShowLogo="True"/>

        <!-- Innhold -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="14,12" Spacing="12">

                <!-- Uke-navigasjon -->
                <Grid ColumnDefinitions="50,*,50">
                    <Button Grid.Column="0"
                            Text="&#xf053;"
                            FontFamily="FontAwesome"
                            FontSize="18"
                            TextColor="{DynamicResource NavInactive}"
                            BackgroundColor="Transparent"
                            HorizontalOptions="Center"
                            Command="{Binding PreviousWeekCommand}"/>
                    <Label Grid.Column="1"
                           Text="{Binding WeekLabel}"
                           FontSize="17"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource TextPrimary}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                    <Button Grid.Column="2"
                            Text="&#xf054;"
                            FontFamily="FontAwesome"
                            FontSize="18"
                            TextColor="{DynamicResource NavInactive}"
                            BackgroundColor="Transparent"
                            HorizontalOptions="Center"
                            Command="{Binding NextWeekCommand}"/>
                </Grid>

                <!-- Ukessøyler -->
                <Border BackgroundColor="{DynamicResource Surface}"
                        StrokeThickness="0"
                        Padding="14,14,14,10">
                    <Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{Binding GoalCaption}"
                               FontSize="12"
                               TextColor="{DynamicResource TextMuted}"
                               HorizontalOptions="Center"/>

                        <!-- Én kolonne per dag: søyle (bunnjustert), kcal og ukedagsbokstav.
                             Søylefeltets høyde leses fra VM-ens BarZoneHeight (x:Static)
                             — samme kilde som søyleberegningen, kan aldri drifte. -->
                        <FlexLayout Direction="Row"
                                    BindableLayout.ItemsSource="{Binding DayBars}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:DayBar">
                                    <Grid FlexLayout.Grow="1"
                                          FlexLayout.Basis="0"
                                          RowSpacing="3"
                                          RowDefinitions="Auto,Auto,Auto"
                                          Margin="4,0">
                                        <!-- Stablet søyle: kos øverst (Treat), sunt nederst.
                                             Ytre Grid gir sonen fast høyde; stacken bunnjusteres i den. -->
                                        <Grid HeightRequest="{x:Static vm:StatsViewModel.BarZoneHeight}">
                                        <VerticalStackLayout Spacing="0"
                                                             VerticalOptions="End"
                                                             HorizontalOptions="Fill">
                                            <BoxView CornerRadius="3,3,0,0"
                                                     HeightRequest="{Binding TreatBarHeight}"
                                                     HorizontalOptions="Fill"
                                                     Color="{DynamicResource Treat}"/>
                                            <BoxView CornerRadius="3"
                                                     HeightRequest="{Binding HealthyBarHeight}"
                                                     HorizontalOptions="Fill"
                                                     Color="{DynamicResource Separator}">
                                                <BoxView.Triggers>
                                                    <DataTrigger TargetType="BoxView"
                                                                 Binding="{Binding IsOnTrack}"
                                                                 Value="True">
                                                        <Setter Property="Color" Value="{DynamicResource Primary}"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="BoxView"
                                                                 Binding="{Binding IsOverLimit}"
                                                                 Value="True">
                                                        <Setter Property="Color" Value="{DynamicResource OverLimit}"/>
                                                    </DataTrigger>
                                                </BoxView.Triggers>
                                            </BoxView>
                                        </VerticalStackLayout>
                                        </Grid>
                                        <Label Grid.Row="1"
                                               Text="{Binding CaloriesText}"
                                               FontSize="10"
                                               TextColor="{DynamicResource TextMuted}"
                                               HorizontalOptions="Center"/>
                                        <Label Grid.Row="2"
                                               Text="{Binding DayLetter}"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               TextColor="{DynamicResource TextSecondary}"
                                               HorizontalOptions="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>

                        <!-- Tomtilstand: melding + handlingsforslag -->
                        <VerticalStackLayout IsVisible="{Binding IsEmpty}"
                                             Spacing="4"
                                             Margin="0,8">
                            <Label Text="{x:Static strings:AppResources.NoDataThisWeek}"
                                   FontSize="14"
                                   TextColor="{DynamicResource TextMuted}"
                                   HorizontalOptions="Center"/>
                            <Label Text="{x:Static strings:AppResources.StatsEmptyHint}"
                                   FontSize="13"
                                   TextColor="{DynamicResource TextSecondary}"
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Nøkkeltall -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                    <Border BackgroundColor="{DynamicResource Surface}" StrokeThickness="0" Padding="10,12">
                        <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding AverageText}" FontSize="20" FontAttributes="Bold"
                                   TextColor="{DynamicResource Primary}" HorizontalOptions="Center"/>
                            <Label Text="{x:Static strings:AppResources.WeekAverage}" FontSize="11"
                                   TextColor="{DynamicResource TextMuted}" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" BackgroundColor="{DynamicResource Surface}" StrokeThickness="0" Padding="10,12">
                        <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding OnTrackText}" FontSize="20" FontAttributes="Bold"
                                   TextColor="{DynamicResource Primary}" HorizontalOptions="Center"/>
                            <Label Text="{x:Static strings:AppResources.DaysOnTrack}" FontSize="11"
                                   TextColor="{DynamicResource TextMuted}" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="2" BackgroundColor="{DynamicResource Surface}" StrokeThickness="0" Padding="10,12">
                        <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding LoggedDaysText}" FontSize="20" FontAttributes="Bold"
                                   TextColor="{DynamicResource Primary}" HorizontalOptions="Center"/>
                            <Label Text="{x:Static strings:AppResources.LoggedDays}" FontSize="11"
                                   TextColor="{DynamicResource TextMuted}" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Fordeling per måltidstype -->
                <Border IsVisible="{Binding HasData}"
                        BackgroundColor="{DynamicResource Surface}"
                        StrokeThickness="0"
                        Padding="16,12">
                    <Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{x:Static strings:AppResources.MealDistribution}"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource TextPrimary}"/>

                        <VerticalStackLayout Spacing="8"
                                             BindableLayout.ItemsSource="{Binding DistributionRows}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:DistributionRow">
                                    <Grid ColumnSpacing="10" ColumnDefinitions="110,*,Auto">
                                        <Label Text="{Binding Label}"
                                               FontSize="13"
                                               TextColor="{DynamicResource TextPrimary}"
                                               VerticalOptions="Center"/>
                                        <ProgressBar Grid.Column="1"
                                                     Progress="{Binding Fraction}"
                                                     ProgressColor="{DynamicResource Primary}"
                                                     BackgroundColor="{DynamicResource Separator}"
                                                     VerticalOptions="Center">
                                            <ProgressBar.Triggers>
                                                <DataTrigger TargetType="ProgressBar"
                                                             Binding="{Binding IsTreat}"
                                                             Value="True">
                                                    <Setter Property="ProgressColor" Value="{DynamicResource Treat}"/>
                                                </DataTrigger>
                                            </ProgressBar.Triggers>
                                        </ProgressBar>
                                        <Label Grid.Column="2"
                                               Text="{Binding DetailText}"
                                               FontSize="12"
                                               TextColor="{DynamicResource TextSecondary}"
                                               VerticalOptions="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Bunn-navigasjon -->
        <navbar:BottomNavBar
            Grid.Row="2"
            ActiveTab="Stats"
            HomeCommand="{Binding GoHomeCommand}"
            MealsCommand="{Binding OpenLibraryCommand}"
            AddCommand="{Binding OpenLogCommand}"
            SettingsCommand="{Binding OpenSettingsCommand}"/>
    </Grid>
</ContentPage>
