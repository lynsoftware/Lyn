<?xml version="1.0" encoding="utf-8" ?>

<!-- Hovedsiden — dagsloggen: sammendragskort øverst, deretter én seksjon
     per måltidstype med innhold eller budsjett. Data fra MainPageViewModel. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:Calorie.Core.Resources.Strings;assembly=Calorie.Core"
             xmlns:dailylog="clr-namespace:Calorie.Core.Features.DailyLog;assembly=Calorie.Core"
             xmlns:vm="clr-namespace:Calorie.Core.Features.DailyLog.ViewModels;assembly=Calorie.Core"
             xmlns:components="clr-namespace:Calorie.Features.DailyLog.Components"
             xmlns:navbar="clr-namespace:Calorie.Features.Navbar.Components"
             xmlns:viewModels="clr-namespace:Calorie.Core.Features.MainPage.ViewModels;assembly=Calorie.Core"
             xmlns:models="using:Calorie.Core.Features.DailyLog.Models"
             x:Class="Calorie.Features.DailyLog.Pages.MainPage"
             x:DataType="viewModels:MainPageViewModel"
             BackgroundColor="{DynamicResource Background}">

    <Grid RowDefinitions="*,Auto,Auto">

        <!-- Dagsloggen — MÅ ligge i *-raden: ScrollView scroller kun når den
             får mindre plass enn innholdet krever -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="14,14,14,20" Spacing="12">

                <components:DaySummaryCard Day="{Binding Day}"
                                           PreviousDayCommand="{Binding PreviousDayCommand}"
                                           NextDayCommand="{Binding NextDayCommand}"
                                           SelectDateCommand="{Binding GoToDateCommand}"/>

                <!-- Tomtilstand: førstegangsopplevelsen og dager uten logg -->
                <VerticalStackLayout IsVisible="{Binding IsDayEmpty}"
                                     Padding="4,36"
                                     Spacing="6">
                    <Label Text="&#xf2e7;"
                           FontFamily="FontAwesome"
                           FontSize="26"
                           TextColor="{DynamicResource TextMuted}"
                           HorizontalOptions="Center"/>
                    <Label Text="{x:Static strings:AppResources.EmptyDayTitle}"
                           FontSize="15"
                           TextColor="{DynamicResource TextSecondary}"
                           HorizontalOptions="Center"/>
                    <Label Text="{x:Static strings:AppResources.EmptyDayHint}"
                           FontSize="13"
                           TextColor="{DynamicResource TextMuted}"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="12"
                                     BindableLayout.ItemsSource="{Binding VisibleSections}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:MealSection">
                            <components:MealSectionCard
                                Section="{Binding .}"
                                AddCommand="{Binding OpenLogFlowCommand,
                                    Source={RelativeSource AncestorType={
                                        x:Type viewModels:MainPageViewModel}},
                                            x:DataType=viewModels:MainPageViewModel}"
                                ItemTappedCommand="{Binding EditEntryCommand,
                                    Source={RelativeSource AncestorType={
                                        x:Type viewModels:MainPageViewModel}},
                                            x:DataType=viewModels:MainPageViewModel}"/>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Rediger loggrad: endre mengde/måltidstype eller slett -->
        <Border Grid.Row="1"
                IsVisible="{Binding IsEditPanelVisible}"
                BackgroundColor="{DynamicResource Surface}"
                StrokeThickness="0"
                Padding="16,12">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="16,16,0,0" />
            </Border.StrokeShape>

            <VerticalStackLayout Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="{Binding EditItemName}"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource TextPrimary}"
                           VerticalOptions="Center"/>
                    <Button Grid.Column="1"
                            Text="&#xf00d;"
                            FontFamily="FontAwesome"
                            FontSize="18"
                            TextColor="{DynamicResource TextMuted}"
                            BackgroundColor="Transparent"
                            Padding="6,0"
                            Command="{Binding CloseEditCommand}"/>
                </Grid>

                <!-- Måltidstype — flytt raden til annet måltid -->
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout Spacing="8"
                                           BindableLayout.ItemsSource="{Binding EditMealTypeOptions}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:MealTypeOption">
                                <Button Text="{Binding Label}"
                                        FontSize="13"
                                        Padding="14,6"
                                        CornerRadius="16"
                                        BackgroundColor="{DynamicResource Background}"
                                        TextColor="{DynamicResource TextSecondary}"
                                        Command="{Binding SelectEditMealTypeCommand,
                                                  Source={RelativeSource AncestorType={x:Type viewModels:MainPageViewModel}},
                                                  x:DataType=viewModels:MainPageViewModel}"
                                        CommandParameter="{Binding .}">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button"
                                                     Binding="{Binding IsSelected}"
                                                     Value="True">
                                            <Setter Property="BackgroundColor" Value="{DynamicResource Primary}"/>
                                            <Setter Property="TextColor" Value="{DynamicResource OnPrimary}"/>
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </ScrollView>

                <!-- Mengde -->
                <Grid ColumnDefinitions="90,Auto,*" ColumnSpacing="10">
                    <Entry Keyboard="Numeric"
                           FontSize="16"
                           Text="{Binding EditAmountText}"
                           TextColor="{DynamicResource TextPrimary}"
                           BackgroundColor="Transparent"/>
                    <Label Grid.Column="1"
                           Text="g"
                           FontSize="15"
                           TextColor="{DynamicResource TextMuted}"
                           VerticalOptions="Center"/>
                </Grid>

                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <Label Text="{Binding EditKcalPreview}"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource Primary}"
                           VerticalOptions="Center"/>
                    <Button Grid.Column="1"
                            Text="{x:Static strings:AppResources.Delete}"
                            Command="{Binding DeleteEntryCommand}"
                            FontSize="15"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource OverLimit}"
                            BackgroundColor="Transparent"
                            BorderColor="{DynamicResource OverLimit}"
                            BorderWidth="1"
                            CornerRadius="12"
                            Padding="18,10"/>
                    <Button Grid.Column="2"
                            Text="{x:Static strings:AppResources.Save}"
                            Command="{Binding SaveEntryCommand}"
                            FontSize="15"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource OnPrimary}"
                            BackgroundColor="{DynamicResource Primary}"
                            CornerRadius="12"
                            Padding="24,10"/>
                </Grid>
            </VerticalStackLayout>
        </Border>

        <!-- Bunn-navigasjon -->
        <navbar:BottomNavBar
            Grid.Row="2"
            ActiveTab="Home"
            AddCommand="{Binding OpenLogFlowCommand}"
            MealsCommand="{Binding OpenLibraryCommand}"
            StatsCommand="{Binding OpenStatsCommand}"
            SettingsCommand="{Binding OpenSettingsCommand}"/>
    </Grid>
</ContentPage>
