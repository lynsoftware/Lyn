<?xml version="1.0" encoding="utf-8" ?>

<!-- Hovedsiden — dagsloggen. Fylles med falske data (Fase 4A) via
     FakeDayFactory; byttes til lokal SQLite i Fase 4B. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:Calorie.Core.Resources.Strings;assembly=Calorie.Core"
             xmlns:components="clr-namespace:Calorie.Features.Navbar.Components"
             xmlns:navbar="clr-namespace:Calorie.Features.Navbar"
             xmlns:components1="clr-namespace:Calorie.Features.Navbar.Components"
             x:Class="Calorie.Features.DailyLog.Pages.MainPage"
             BackgroundColor="{DynamicResource Background}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header Card -->
        <Border
            Grid.Row="0"
            BackgroundColor="{DynamicResource Surface}"
            Padding="10,10"
            StrokeThickness="0"
            HorizontalOptions="FillAndExpand">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0" />
            </Border.StrokeShape>

            <Border.Shadow>
                <Shadow Brush="Black"
                        Opacity="0.15"
                        Radius="20"
                        Offset="0,5" />
            </Border.Shadow>

            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="60" />
                </Grid.ColumnDefinitions>

                <!-- Logo - Left Column -->
                <Image Source="logo.png"
                       Grid.Column="0"
                       WidthRequest="70"
                       HeightRequest="70"
                       VerticalOptions="Center"
                       HorizontalOptions="Center"/>

                <!-- App Title - Middle column -->
                <Label
                    Grid.Column="1"
                    Text="{x:Static strings:AppResources.AppTitle}"
                    FontSize="28"
                    FontAttributes="Bold"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    TextColor="{DynamicResource Primary}"/>
            </Grid>
        </Border>

        <!-- Dagsloggen -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout x:Name="DayContainer"
                                 Padding="14,14,14,20"
                                 Spacing="12"/>
        </ScrollView>

        <!-- Bunn-navigasjon -->
        <components1:BottomNavBar
            Grid.Row="2"
            ActiveTab="Home"
            AddClicked="OnAddClicked"
            MealsClicked="OnMealsClicked"
            StatsClicked="OnStatsClicked"
            SettingsClicked="OnSettingsClicked"/>
    </Grid>
</ContentPage>
