<?xml version="1.0" encoding="utf-8" ?>

<!-- Logge-flyten (pluss-knappen): velg måltidstype (auto-foreslått), søk i
     biblioteket (Måltider/Ingredienser/Skann), angi mengde i gram eller stykk,
     og legg til i dagsloggen. Fake bibliotek i Fase 4A. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:Calorie.Core.Resources.Strings;assembly=Calorie.Core"
             xmlns:library="clr-namespace:Calorie.Core.Features.Library;assembly=Calorie.Core"
             x:Class="Calorie.Features.DailyLog.Pages.AddLogEntryPage"
             BackgroundColor="{DynamicResource Background}"
             xmlns:vm="clr-namespace:Calorie.Core.Features.DailyLog.ViewModels;assembly=Calorie.Core"
             x:DataType="vm:AddLogEntryViewModel"
             xmlns:common="clr-namespace:Calorie.Common.Components"
             xmlns:viewModels="clr-namespace:Calorie.Core.Features.Library.ViewModels;assembly=Calorie.Core">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">

        <!-- Header -->
        <!-- Tittelen viser måldatoen når det logges bakover ("Logg mat — fre 25. jul") -->
        <common:PageHeader Grid.Row="0"
                           Title="{Binding LogTitle}"
                           ShowCloseButton="True"
                           CloseCommand="{Binding CloseCommand}"/>

        <!-- Måltidstype-chips — bygges i code-behind -->
        <ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout BindableLayout.ItemsSource="{Binding MealTypeOptions}"
                                   Spacing="8"
                                   Padding="14,12,14,4">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:MealTypeOption">
                        <Button Text="{Binding Label}"
                                FontSize="13"
                                Padding="14,6"
                                CornerRadius="16"
                                BackgroundColor="{DynamicResource Surface}"
                                TextColor="{DynamicResource TextSecondary}"
                                Command="{Binding SelectMealTypeCommand,
                                      Source={RelativeSource AncestorType={x:Type vm:AddLogEntryViewModel}},
                                      x:DataType=vm:AddLogEntryViewModel}"
                                CommandParameter="{Binding .}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" 
                                             Binding="{Binding IsSelected}"
                                             Value="True">
                                    <Setter Property="BackgroundColor" Value="{DynamicResource Primary}"/>
                                    <Setter Property="TextColor" Value="{DynamicResource OnPrimary}"/>
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </DataTemplate>
            </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>
                                            
        </ScrollView>

        <!-- Søk -->
        <Border Grid.Row="2"
                BackgroundColor="{DynamicResource Surface}"
                StrokeThickness="0"
                Margin="14,8,14,0"
                Padding="12,0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>
            <Entry Placeholder="{x:Static strings:AppResources.SearchPlaceholder}"
                   Text="{Binding SearchText}"
                   BackgroundColor="Transparent"
                   TextColor="{DynamicResource TextPrimary}"
                   PlaceholderColor="{DynamicResource TextMuted}"/>
        </Border>

        <!-- Faner + ny-knapp (følger aktiv fane) -->
        <Grid Grid.Row="3" 
              ColumnDefinitions="Auto,Auto,Auto,*,Auto" 
              Padding="18,6,14,6" 
              ColumnSpacing="18">
            
            <Button Text="{x:Static strings:AppResources.TabMeals}"
                    Command="{Binding SelectTabCommand}"
                    CommandParameter="{x:Static viewModels:LibraryItemKind.Meal}"
                    TextColor="{DynamicResource TextMuted}"
                    FontSize="15"
                    FontAttributes="Bold"
                    BackgroundColor="Transparent"
                    Padding="0">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" 
                                 Binding="{Binding IsMealsTabActive}" 
                                 Value="true">
                        <Setter Property="TextColor" Value="{DynamicResource Primary}"/>
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Grid.Column="1"
                    Text="{x:Static strings:AppResources.TabIngredients}"
                    Command="{Binding SelectTabCommand}"
                    CommandParameter="{x:Static viewModels:LibraryItemKind.Ingredient}"
                    TextColor="{DynamicResource TextMuted}"
                    FontSize="15"
                    FontAttributes="Bold"
                    BackgroundColor="Transparent"
                    Padding="0"
                    >
                <Button.Triggers>
                    <DataTrigger TargetType="Button" 
                                 Binding="{Binding IsIngredientsTabActive}" 
                                 Value="true">
                        <Setter Property="TextColor" Value="{DynamicResource Primary}"/>
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Grid.Column="2"
                    Text="{x:Static strings:AppResources.TabScan}"
                    FontSize="15"
                    FontAttributes="Bold"
                    BackgroundColor="Transparent"
                    Padding="0"
                    Command="{Binding ScanCommand}"/>

            <Button Grid.Column="4"
                    Text="{Binding NewItemButtonText}"
                    FontSize="13"
                    FontAttributes="Bold"
                    TextColor="{DynamicResource OnPrimary}"
                    BackgroundColor="{DynamicResource Primary}"
                    CornerRadius="14"
                    Padding="14,6"
                    Command="{Binding NewItemCommand}"/>
        </Grid>

        <!-- Bibliotek-listen -->
        <CollectionView Grid.Row="4"
                        Margin="14,0"
                        ItemsSource="{Binding FilteredItems}"
                        SelectedItem="{Binding SelectedListItem}"
                        SelectionMode="Single">
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="4,24" Spacing="4">
                    <Label Text="{x:Static strings:AppResources.NoLibraryMatches}"
                           FontSize="14"
                           TextColor="{DynamicResource TextMuted}"
                           HorizontalOptions="Center"/>
                    <Label Text="{Binding EmptyHint}"
                           FontSize="13"
                           TextColor="{DynamicResource TextSecondary}"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="viewModels:LibraryItem">
                    <Grid Padding="4,10" ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="1">
                            <Label Text="{Binding Name}"
                                   FontSize="15"
                                   TextColor="{DynamicResource TextPrimary}"/>
                            <Label Text="{Binding Details}"
                                   FontSize="12"
                                   TextColor="{DynamicResource TextMuted}"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="1"
                               Text="{Binding Brand}"
                               FontSize="12"
                               TextColor="{DynamicResource TextMuted}"
                               VerticalOptions="Center"/>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Valgt vare: mengde + bekreft -->
        <Border Grid.Row="5"
                IsVisible="{Binding IsSelectionPanelVisible}"
                BackgroundColor="{DynamicResource Surface}"
                StrokeThickness="0"
                Padding="16,12">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="16,16,0,0" />
            </Border.StrokeShape>

            <VerticalStackLayout Spacing="8">
                <Label Text="{Binding ActiveItemDisplayName}" 
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource TextPrimary}"/>

                <Label Text="{x:Static strings:AppResources.AmountGramsLabel}"
                       FontSize="12"
                       TextColor="{DynamicResource TextMuted}"/>

                <Grid ColumnDefinitions="90,Auto,*" ColumnSpacing="10">
                    <Entry Keyboard="Numeric"
                           FontSize="16"
                           Text="{Binding AmountText}"
                           TextColor="{DynamicResource TextPrimary}"
                           BackgroundColor="Transparent"/>
                    <Label Grid.Column="1"
                           Text="g"
                           FontSize="15"
                           TextColor="{DynamicResource TextMuted}"
                           VerticalOptions="Center"/>

                    <HorizontalStackLayout Grid.Column="2"
                                           BindableLayout.ItemsSource="{Binding UnitOptions}"
                                           Spacing="6"
                                           HorizontalOptions="End">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:UnitOption">
                                <Button Text="{Binding Label}"
                                        FontSize="12"
                                        Padding="10,4"
                                        CornerRadius="12"
                                        BackgroundColor="{DynamicResource Background}"
                                        TextColor="{DynamicResource TextSecondary}"
                                        Command="{Binding SetUnitAmountCommand,
                              Source={RelativeSource AncestorType={x:Type vm:AddLogEntryViewModel}},
                              x:DataType=vm:AddLogEntryViewModel}"
                                        CommandParameter="{Binding .}"/>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </Grid>

                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <Label Text="{Binding KcalPreview}"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource Primary}"
                           VerticalOptions="Center"/>

                    <!-- Kun for måltider: åpne engangs-kopi i måltidsbyggeren -->
                    <Button Grid.Column="1"
                            IsVisible="{Binding CanCustomize}"
                            Text="{x:Static strings:AppResources.Customize}"
                            FontSize="15"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource Primary}"
                            BackgroundColor="Transparent"
                            BorderColor="{DynamicResource Primary}"
                            BorderWidth="1"
                            CornerRadius="12"
                            Padding="18,10"
                            Command="{Binding CustomizeCommand}" 
                    />
                    <Button Grid.Column="2"
                            Text="{x:Static strings:AppResources.AddFood}"
                            Command="{Binding ConfirmAddCommand}"
                            FontSize="15"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource OnPrimary}"
                            BackgroundColor="{DynamicResource Primary}"
                            CornerRadius="12"
                            Padding="24,10"/>
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
