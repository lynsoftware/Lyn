<?xml version="1.0" encoding="utf-8" ?>

<!-- Logge-flyten (pluss-knappen): velg måltidstype (auto-foreslått), søk i
     biblioteket (Måltider/Ingredienser/Skann), angi mengde i gram eller stykk,
     og legg til i dagsloggen. Fake bibliotek i Fase 4A. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:Calorie.Core.Resources.Strings;assembly=Calorie.Core"
             xmlns:library="clr-namespace:Calorie.Core.Features.Library;assembly=Calorie.Core"
             x:Class="Calorie.Features.DailyLog.Pages.AddLogEntryPage"
             BackgroundColor="{DynamicResource Background}"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:vm="clr-namespace:Calorie.Features.DailyLog.ViewModels"
             x:DataType="vm:AddLogEntryViewModel">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">

        <!-- Header -->
        <Border Grid.Row="0"
                BackgroundColor="{DynamicResource Surface}"
                Padding="10,10"
                StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0" />
            </Border.StrokeShape>

            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="60" />
                </Grid.ColumnDefinitions>

                <Label Grid.Column="1"
                       Text="{x:Static strings:AppResources.LogFoodTitle}"
                       FontSize="24"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       TextColor="{DynamicResource Primary}"/>

                <Button Grid.Column="2"
                        Text="&#xf00d;"
                        FontFamily="FontAwesome"
                        FontSize="24"
                        TextColor="{DynamicResource Primary}"
                        BackgroundColor="Transparent"
                        WidthRequest="50"
                        HeightRequest="50"
                        VerticalOptions="Center"
                        HorizontalOptions="Center"
                        Clicked="OnCloseClicked"/>
            </Grid>
        </Border>

        <!-- Måltidstype-chips — bygges i code-behind -->
        <ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout x:Name="ChipsContainer"
                                   Spacing="8"
                                   Padding="14,12,14,4"/>
        </ScrollView>

        <!-- Søk -->
        <Border Grid.Row="2"
                BackgroundColor="{DynamicResource Surface}"
                StrokeThickness="0"
                Margin="14,8,14,0"
                Padding="12,0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>
            <Entry Placeholder="{x:Static strings:AppResources.SearchPlaceholder}"
                   Text="{Binding SearchText}"
                   BackgroundColor="Transparent"
                   TextColor="{DynamicResource TextPrimary}"
                   PlaceholderColor="{DynamicResource TextMuted}"/>
        </Border>

        <!-- Faner + ny-knapp (følger aktiv fane) -->
        <Grid Grid.Row="3" 
              ColumnDefinitions="Auto,Auto,Auto,*,Auto" 
              Padding="18,6,14,6" 
              ColumnSpacing="18">
            
            <Button Text="{x:Static strings:AppResources.TabMeals}"
                    Command="{Binding SelectTabCommand}"
                    CommandParameter="{x:Static library:LibraryItemKind.Meal}"
                    TextColor="{DynamicResource TextMuted}"
                    FontSize="15"
                    FontAttributes="Bold"
                    BackgroundColor="Transparent"
                    Padding="0">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" 
                                 Binding="{Binding IsMealsTabActive}" 
                                 Value="true">
                        <Setter Property="TextColor" Value="{DynamicResource Primary}"/>
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Grid.Column="1"
                    Text="{x:Static strings:AppResources.TabIngredients}"
                    Command="{Binding SelectTabCommand}"
                    CommandParameter="{x:Static library:LibraryItemKind.Ingredient}"
                    TextColor="{DynamicResource TextMuted}"
                    FontSize="15"
                    FontAttributes="Bold"
                    BackgroundColor="Transparent"
                    Padding="0"
                    >
                <Button.Triggers>
                    <DataTrigger TargetType="Button" 
                                 Binding="{Binding IsIngredientsTabActive}" 
                                 Value="true">
                        <Setter Property="TextColor" Value="{DynamicResource Primary}"/>
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button x:Name="ScanTabButton"
                    Grid.Column="2"
                    Text="{x:Static strings:AppResources.TabScan}"
                    FontSize="15"
                    FontAttributes="Bold"
                    BackgroundColor="Transparent"
                    Padding="0"
                    Clicked="OnScanTabClicked"/>

            <Button x:Name="NewItemButton"
                    Grid.Column="4"
                    FontSize="13"
                    FontAttributes="Bold"
                    TextColor="{DynamicResource OnPrimary}"
                    BackgroundColor="{DynamicResource Primary}"
                    CornerRadius="14"
                    Padding="14,6"
                    Clicked="OnNewItemClicked"/>
        </Grid>

        <!-- Bibliotek-listen -->
        <CollectionView x:Name="ItemsList"
                        Grid.Row="4"
                        Margin="14,0"
                        SelectionMode="Single"
                        SelectionChanged="OnItemSelected">
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="4,24" Spacing="4">
                    <Label Text="{x:Static strings:AppResources.NoLibraryMatches}"
                           FontSize="14"
                           TextColor="{DynamicResource TextMuted}"
                           HorizontalOptions="Center"/>
                    <Label x:Name="EmptyHintLabel"
                           FontSize="13"
                           TextColor="{DynamicResource TextSecondary}"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="library:LibraryItem">
                    <Grid Padding="4,10" ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="1">
                            <Label Text="{Binding Name}"
                                   FontSize="15"
                                   TextColor="{DynamicResource TextPrimary}"/>
                            <Label Text="{Binding Details}"
                                   FontSize="12"
                                   TextColor="{DynamicResource TextMuted}"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="1"
                               Text="{Binding Brand}"
                               FontSize="12"
                               TextColor="{DynamicResource TextMuted}"
                               VerticalOptions="Center"/>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Valgt vare: mengde + bekreft -->
        <Border x:Name="SelectionPanel"
                Grid.Row="5"
                IsVisible="False"
                BackgroundColor="{DynamicResource Surface}"
                StrokeThickness="0"
                Padding="16,12">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="16,16,0,0" />
            </Border.StrokeShape>

            <VerticalStackLayout Spacing="8">
                <Label x:Name="SelectedNameLabel"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource TextPrimary}"/>

                <Label Text="{x:Static strings:AppResources.AmountGramsLabel}"
                       FontSize="12"
                       TextColor="{DynamicResource TextMuted}"/>

                <Grid ColumnDefinitions="90,Auto,*" ColumnSpacing="10">
                    <Entry x:Name="AmountEntry"
                           Keyboard="Numeric"
                           FontSize="16"
                           TextColor="{DynamicResource TextPrimary}"
                           BackgroundColor="Transparent"
                           TextChanged="OnAmountChanged"/>
                    <Label Grid.Column="1"
                           Text="g"
                           FontSize="15"
                           TextColor="{DynamicResource TextMuted}"
                           VerticalOptions="Center"/>

                    <!-- Stykk-snarveier ("1 stk = 60 g") — bygges i code-behind -->
                    <HorizontalStackLayout x:Name="UnitButtonsContainer"
                                           Grid.Column="2"
                                           Spacing="6"
                                           HorizontalOptions="End"/>
                </Grid>

                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <Label x:Name="KcalPreviewLabel"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource Primary}"
                           VerticalOptions="Center"/>

                    <!-- Kun for måltider: åpne engangs-kopi i måltidsbyggeren -->
                    <Button x:Name="CustomizeButton"
                            Grid.Column="1"
                            IsVisible="False"
                            Text="{x:Static strings:AppResources.Customize}"
                            FontSize="15"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource Primary}"
                            BackgroundColor="Transparent"
                            BorderColor="{DynamicResource Primary}"
                            BorderWidth="1"
                            CornerRadius="12"
                            Padding="18,10"
                            Clicked="OnCustomizeClicked"/>
                    <Button x:Name="AddConfirmButton"
                            Grid.Column="2"
                            FontSize="15"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource OnPrimary}"
                            BackgroundColor="{DynamicResource Primary}"
                            CornerRadius="12"
                            Padding="24,10"
                            Clicked="OnConfirmAddClicked"/>
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
