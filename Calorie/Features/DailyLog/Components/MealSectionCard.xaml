<?xml version="1.0" encoding="utf-8" ?>

<!-- Én måltidsseksjon i dagsloggen: navn, spist/budsjett, loggrader og
     legg-til-knapp. Fylles via SetSection(MealSection). Farger via tema-tokens. -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Calorie.Features.DailyLog.Components.MealSectionCard">

    <Border BackgroundColor="{DynamicResource Surface}"
            Padding="16,12"
            StrokeThickness="0">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="16" />
        </Border.StrokeShape>

        <VerticalStackLayout Spacing="8">

            <!-- Header: måltidsnavn + spist/budsjett -->
            <Grid ColumnDefinitions="*,Auto">
                <Label x:Name="TitleLabel"
                       FontSize="17"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource TextPrimary}"
                       VerticalOptions="Center"/>

                <VerticalStackLayout Grid.Column="1" Spacing="1">
                    <Label x:Name="BudgetLabel"
                           FontSize="14"
                           TextColor="{DynamicResource TextSecondary}"
                           HorizontalOptions="End"/>
                    <Label x:Name="RemainingLabel"
                           FontSize="12"
                           HorizontalOptions="End"/>
                </VerticalStackLayout>
            </Grid>

            <BoxView x:Name="Separator"
                     HeightRequest="1"
                     Color="{DynamicResource Separator}"/>

            <!-- Loggrader — fylles i code-behind -->
            <VerticalStackLayout x:Name="ItemsContainer" Spacing="6"/>

            <!-- Legg til -->
            <Button x:Name="AddButton"
                    FontSize="14"
                    TextColor="{DynamicResource Primary}"
                    BackgroundColor="Transparent"
                    Padding="0"
                    HorizontalOptions="Start"
                    Clicked="OnAddClicked"/>
        </VerticalStackLayout>
    </Border>
</ContentView>
