<?xml version="1.0" encoding="utf-8" ?>

<!-- Dagens totaler: dato-navigasjon, spist/igjen mot dagsmålet og makro-rad.
     Fylles via Update(DayLog). Farger via tema-tokens. -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Calorie.Features.DailyLog.Components.DaySummaryCard">

    <Border BackgroundColor="{DynamicResource Surface}"
            Padding="20,16"
            StrokeThickness="0">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="16" />
        </Border.StrokeShape>
        <Border.Shadow>
            <Shadow Brush="Black"
                    Opacity="0.15"
                    Radius="20"
                    Offset="0,5" />
        </Border.Shadow>

        <VerticalStackLayout Spacing="10">

            <!-- Dato-navigasjon -->
            <Grid ColumnDefinitions="44,*,Auto">
                <Button x:Name="PreviousDayButton"
                        Grid.Column="0"
                        Text="&#xf053;"
                        Padding="0"
                        FontFamily="FontAwesome"
                        FontSize="18"
                        TextColor="{DynamicResource NavInactive}"
                        BackgroundColor="Transparent"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Clicked="OnPreviousDayClicked"/>
                
                <Grid Grid.Column="1"
                      HorizontalOptions="Center"
                      VerticalOptions="Center">

                    <HorizontalStackLayout Spacing="8">
                        <Label x:Name="DateLabel"
                               Padding="8,10"
                               LineBreakMode="TailTruncation"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource TextPrimary}"
                               VerticalOptions="Center"/>
                        <Label Text="&#xf073;"
                               FontFamily="FontAwesome"
                               FontSize="14"
                               TextColor="{DynamicResource TextMuted}"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>

                    <!-- Usynlig DatePicker strukket over hele klyngen — native trykk 
                         hvor som helst på datoen åpner kalenderdialogen -->
                    <DatePicker x:Name="HiddenDatePicker"
                                Opacity="0"
                                HorizontalOptions="Fill"
                                VerticalOptions="Fill"
                                DateSelected="OnDateSelected"/>
                </Grid>
                
                <!-- Fremover-klyngen: neste dag + hopp til i dag -->
                <HorizontalStackLayout Grid.Column="2"
                                       Spacing="0"
                                       VerticalOptions="Center">
                    
                    <Button x:Name="NextDayButton"
                            WidthRequest="32"
                            MinimumWidthRequest="32"
                            Padding="0"
                            Text="&#xf054;"
                            FontFamily="FontAwesome"
                            FontSize="18"
                            TextColor="{DynamicResource NavInactive}"
                            BackgroundColor="Transparent"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            Clicked="OnNextDayClicked"/>
                    
                    <!-- Hopp til i dag (>|) — deaktivert når dagens dato vises -->
                    <Button x:Name="TodayButton"
                            WidthRequest="32"
                            MinimumWidthRequest="32"
                            Padding="0"
                            Text="&#xf051;"
                            FontFamily="FontAwesome"
                            FontSize="18"
                            TextColor="{DynamicResource NavInactive}"
                            BackgroundColor="Transparent"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            Clicked="OnTodayClicked"/>
                </HorizontalStackLayout>
            </Grid>

            <!-- Totalt spist / mål -->
            <Label x:Name="TotalsLabel"
                   FontSize="34"
                   FontAttributes="Bold"
                   TextColor="{DynamicResource Primary}"
                   HorizontalOptions="Center"/>

            <!-- Segmentert fremdrift: sunt (gull) + kos (lilla) mot dagsmålet.
                 Segmentene bygges i code-behind (UpdateProgressSegments). -->
            <Border HeightRequest="10"
                    BackgroundColor="{DynamicResource Separator}"
                    StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="5"/>
                </Border.StrokeShape>
                <Grid x:Name="ProgressSegments" ColumnSpacing="0"/>
            </Border>

            <Label x:Name="RemainingLabel"
                   FontSize="15"
                   TextColor="{DynamicResource TextSecondary}"
                   HorizontalOptions="Center"/>

            <!-- Kos-status: "X kcal kos igjen" — kun når kos-andel er satt -->
            <Label x:Name="TreatRemainingLabel"
                   IsVisible="False"
                   FontSize="13"
                   HorizontalOptions="Center"/>

            <!-- Makro-rad -->
            <HorizontalStackLayout Spacing="28" HorizontalOptions="Center">
                <Label x:Name="ProteinLabel" FontSize="14" TextColor="{DynamicResource TextSecondary}"/>
                <Label x:Name="CarbsLabel" FontSize="14" TextColor="{DynamicResource TextSecondary}"/>
                <Label x:Name="FatLabel" FontSize="14" TextColor="{DynamicResource TextSecondary}"/>
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </Border>
</ContentView>
